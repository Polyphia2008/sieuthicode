# Local deployment configuration and runtime secrets
.env
config.local.php
security/*.pem
security/.keygen.lock

# Runtime logs/caches
*.log
update.txt

# IDE/OS files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Uploaded chat attachments (user-generated runtime content; never commit).
# Keep the tracked .gitkeep and .htaccess that protect the directory.
upload/chat/*
!upload/chat/.gitkeep
!upload/chat/.htaccess
