RewriteRule ^model/admin/modal/withdraws/?$ models/admin/modal/withdraws.php [L,QSA,NC]

# Collaborator model endpoints.
RewriteRule ^model/ctv/account/?$ models/ctv/account.php [L,QSA,NC]
RewriteRule ^model/ctv/listaccount/?$ models/ctv/listaccount.php [L,QSA,NC]
