DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Do not expose application internals, credentials or database exports.
# THE_REQUEST keeps internal rewrites to model PHP files working.
RewriteCond %{THE_REQUEST} \s/+((classes|libs|models|security|vendor)/) [NC]
RewriteRule ^ - [F,L]
RewriteCond %{THE_REQUEST} \s/+(config\.php|config\.local\.php|composer\.(json|lock)|version\.php|update\.php|[^?\s]*\.sql)([?\s]) [NC]
RewriteRule ^ - [F,L]
# Runtime state directory (installed.lock, mutex, journal) is never served directly.
RewriteCond %{THE_REQUEST} \s/+storage/ [NC]
RewriteRule ^ - [F,L]
# Internal installer includes are never served directly (wizard + API stay public).
RewriteCond %{THE_REQUEST} \s/+install/bootstrap\.php([?\s]) [NC]
RewriteRule ^ - [F,L]
# Test scripts are CLI-only, never web-accessible.
RewriteCond %{THE_REQUEST} \s/+tests/ [NC]
RewriteRule ^ - [F,L]

# Installer wizard (self-locks once the site is installed).
RewriteRule ^install/?$ install/index.php [L,QSA,NC]
RewriteCond %{THE_REQUEST} \s/+((assets|upload)/[^?\s]*\.(php[0-9]?|phtml|phar))([?\s]) [NC]
RewriteRule ^ - [F,L]
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# Friendly model/API endpoints.
RewriteRule ^model/login/?$ models/client/login.php [L,QSA,NC]
RewriteRule ^model/register/?$ models/client/register.php [L,QSA,NC]
RewriteRule ^model/forgotpassword/?$ models/client/forgotpasword.php [L,QSA,NC]
RewriteRule ^model/authenticator/?$ models/client/authenticator.php [L,QSA,NC]
RewriteRule ^model/getbanks/?$ models/client/banks.php [L,QSA,NC]
RewriteRule ^model/buy/account/?$ models/client/buyaccount.php [L,QSA,NC]
RewriteRule ^model/account/list/?$ models/client/account.php [L,QSA,NC]
RewriteRule ^model/captcha/?$ models/client/captcha.php [L,QSA,NC]
RewriteRule ^model/card/?$ models/client/card.php [L,QSA,NC]
RewriteRule ^model/event/?$ models/client/event.php [L,QSA,NC]
RewriteRule ^model/favourite/?$ models/client/favourite.php [L,QSA,NC]
RewriteRule ^model/get_item_details/?$ models/client/get_item_details.php [L,QSA,NC]
RewriteRule ^model/item/?$ models/client/items.php [L,QSA,NC]
RewriteRule ^model/load/flashsale/?$ models/client/loadflashsale.php [L,QSA,NC]
RewriteRule ^model/reviews/?$ models/client/reviews.php [L,QSA,NC]
RewriteRule ^model/service/?$ models/client/service.php [L,QSA,NC]
RewriteRule ^model/service/item/?$ models/client/items.php [L,QSA,NC]
RewriteRule ^model/spin-quest/?$ models/client/spin-quest.php [L,QSA,NC]
RewriteRule ^model/update/info/?$ models/client/updateinfo.php [L,QSA,NC]
RewriteRule ^model/update/password/?$ models/client/updatepassword.php [L,QSA,NC]
RewriteRule ^model/withdraw/?$ models/client/withdraw.php [L,QSA,NC]

# Chat support (member) endpoints.
RewriteRule ^model/chat/conversation/?$ models/client/chat/conversation.php [L,QSA,NC]
RewriteRule ^model/chat/messages/?$ models/client/chat/messages.php [L,QSA,NC]
RewriteRule ^model/chat/send/?$ models/client/chat/send.php [L,QSA,NC]
RewriteRule ^model/chat/read/?$ models/client/chat/read.php [L,QSA,NC]
RewriteRule ^model/chat/reopen/?$ models/client/chat/reopen.php [L,QSA,NC]
