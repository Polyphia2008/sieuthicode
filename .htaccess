# Customer pages.
RewriteRule ^customer/profile/?$ views/profile/index.php [L,QSA,NC]
RewriteRule ^customer/profile/update/?$ views/profile/update.php [L,QSA,NC]
RewriteRule ^customer/change/password/?$ views/profile/changepassword.php [L,QSA,NC]
